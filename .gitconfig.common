[alias]
    ci = commit
    co = checkout
    st = status
    br = branch
    
[core]
    editor = vim
    excludesfile = ~/.gitignore_global

[init]
    defaultBranch = main

[pull]
	rebase = true

[filter "lfs"]
	required = true
	clean = git-lfs clean -- %f
	smudge = git-lfs smudge -- %f
	process = git-lfs filter-process
